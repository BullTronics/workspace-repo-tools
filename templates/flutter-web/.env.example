# =============================================================================
# Flutter Web Environment Variables (Example)
# Copy this file to .env and update values for your local environment.
# =============================================================================

# Unique slug used for isolated Chrome user-data directory
APP_SLUG=my-flutter-app

# Local Web Server Port
PORT=3000

# Backend API URL (injected via --dart-define-from-file=.env)
API_HOST=http://localhost:8080

# Optional custom Chrome user data directory
CHROME_USER_DATA_DIR=

# Optional extra flags passed to 'flutter run'
FLUTTER_EXTRA_ARGS=

