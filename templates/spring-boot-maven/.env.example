# =============================================================================
# Spring Boot Backend Environment Variables (Example)
# Copy this file to .env and update values for your local environment.
# =============================================================================

PORT=8080
APP_ENV=local
JVM_ARGS=-Duser.timezone=UTC

# Database Settings
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=app_dev

# CORS / Frontend
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Optional Packaged JAR Path (used by start-server.ps1)
# JAR_FILE=target/app-1.0.0.jar

