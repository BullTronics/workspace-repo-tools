# Spring Boot Environment Variables (Example)
PORT=8080
APP_ENV=local
JVM_ARGS=-Duser.timezone=UTC
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=app_dev
# Optional packaged JAR path to run via `java -jar` instead of `mvn spring-boot:run`
# JAR_FILE=target/app-1.0.0.jar

